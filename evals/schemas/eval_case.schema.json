{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalCase",
  "type": "object",
  "required": [
    "case_id",
    "scenario_type",
    "artifacts",
    "expected_claims",
    "expected_outcomes",
    "expected_support_status",
    "expected_requires_review",
    "expected_recommended_action",
    "expected_citation_targets"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "scenario_type": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "text"
        ],
        "properties": {
          "artifact_type": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "expected_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_type",
          "claim_text_contains"
        ],
        "properties": {
          "claim_type": {
            "type": "string"
          },
          "claim_text_contains": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "expected_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_support_status": {
      "type": "string"
    },
    "expected_requires_review": {
      "type": "boolean"
    },
    "expected_recommended_action": {
      "type": "string"
    },
    "expected_citation_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_type"
        ],
        "properties": {
          "artifact_type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}